	rename -uid "C5D2A3E9-4B2E-1887-5A0A-F8BAE7BF9C18";
	addAttr -ci true -sn "precode" -ln "precode" -dt "string";
	addAttr -ci true -sn "Build_Command" -ln "Build_Command" -dt "string";
