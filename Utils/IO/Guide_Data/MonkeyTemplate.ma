createNode network -n "HandFootCode_Config";
	rename -uid "089FFB70-5A43-D731-EDA5-77A51633352E";
	addAttr -ci true -sn "precode" -ln "precode" -dt "string";
	addAttr -ci true -sn "Build_Command" -ln "Build_Command" -dt "string";
	addAttr -ci true -sn "Import_Command" -ln "Import_Command" -dt "string";
	addAttr -ci true -sn "Exec" -ln "Exec" -min 0 -max 1 -en "Python:Mel" -at "enum";
	addAttr -ci true -sn "Code" -ln "Code" -dt "string";
	addAttr -ci true -sn "postcode" -ln "postcode" -dt "string";
	setAttr ".precode" -type "string" "";
	setAttr -l on ".Build_Command" -type "string" "exec_code.build_code_block()";
	setAttr -l on ".Import_Command" -type "string" "import exec_code";
	setAttr -cb on ".Exec";
	setAttr ".Code" -type "string" (
		"from maya import cmds\n\n\"\"\"\nConstraining hand fingers to handFoot toe joint\n\"\"\"\nfor ltr in [\"L\", \"R\"]:\n    for grp in [\"_Hand_Pinky_01_Ctrl_Offset_Grp\", \"_Hand_Ring_01_Ctrl_Offset_Grp\", \"_Hand_Middle_01_Ctrl_Offset_Grp\", \"_Hand_Index_01_Ctrl_Offset_Grp\"]:\n        cmds.parentConstraint(\"{}_HandFoot_BallToes_Bnd\".format(ltr), \"{}{}\".format(ltr, grp), mo=True)\n\n\n\n\"\"\"\nAdding a series of offset groups above the first finger joint of the four main finger joints in \norder to reconnect them to the metacarpals after they are constrained to the ball joint. \n\"\"\"\n\n\ndef create_object_specific_offset(ctrl_sel=[], main_ctrl=\"\", connect=False, blend_nodes=True):\n    # Defining Attribute lists.\n    attrs_0 = [\"translateX\", \"translateY\", \"translateZ\", \"rotateX\", \"rotateY\", \"rotateZ\"]\n    attrs_1 = [\"scaleX\", \"scaleY\", \"scaleZ\"]\n\n    for ctrl in ctrl_sel:\n        # Creating world offset groups and placing them in hierarchy.\n        new_null_group = cmds.group(name=\"{}_MainOrient_grp\".format(ctrl), empty=True)\n        cmds.matchTransform(new_null_group, main_ctrl, position=True, rotation=True)\n"
		+ "\n        # Matching pivot with specified object\n        piv = cmds.xform(main_ctrl, q=True, ws=True, t=True)\n        cmds.xform(new_null_group, ws=True, piv=piv)\n\n        # Placing new group in hierarchy\n        ctrl_parent = cmds.listRelatives(ctrl, parent=True)\n        cmds.parent(new_null_group, ctrl_parent)\n\n        # Creating world offset group and placing it in hierarchy.\n        world_offset_group = cmds.duplicate(new_null_group, name=\"{}_offset_grp\".format(new_null_group))\n        cmds.parent(ctrl, new_null_group)\n        cmds.parent(new_null_group, world_offset_group)\n\n        # Creating ctrl offset group and placing it in hierarchy so it keeps its values.\n        LocalOffset_group = cmds.group(name=\"{}_LocalOrientOffset_grp\".format(ctrl), empty=True)\n        cmds.parent(LocalOffset_group, ctrl)\n\n        # Setting attributes to 0 and 1.\n        for attr in attrs_0:\n            cmds.setAttr(\"{}.{}\".format(LocalOffset_group, attr), 0)\n        for attr in attrs_1:\n            cmds.setAttr(\"{}.{}\".format(LocalOffset_group, attr), 1)\n"
		+ "\n        # Placing ctrl inside offset group.\n        cmds.parent(LocalOffset_group, new_null_group)\n        cmds.parent(ctrl, LocalOffset_group)\n        \n        \n        if connect:            \n            \n            for attr in attrs_0:\n                cmds.connectAttr(\"{}.{}\".format(main_ctrl, attr), \"{}.{}\".format(new_null_group, attr))\n            for attr in attrs_1:\n                cmds.connectAttr(\"{}.{}\".format(main_ctrl, attr), \"{}.{}\".format(new_null_group, attr))\n                \n        if blend_nodes:\n        \n            #Creating blend nodes. \n            trans_blend_node = cmds.shadingNode(\"blendColors\", asUtility=True, name=\"{}_{}_TransBlend\".format(main_ctrl, ctrl))\n            cmds.setAttr(\"{}.blender\".format(trans_blend_node), 1)\n            cmds.setAttr(\"{}.color2B\".format(trans_blend_node), 0)\n            \n            rot_blend_node = cmds.shadingNode(\"blendColors\", asUtility=True, name=\"{}_{}_RotBlend\".format(main_ctrl, ctrl))\n            cmds.setAttr(\"{}.blender\".format(rot_blend_node), 1)\n"
		+ "            cmds.setAttr(\"{}.color2B\".format(rot_blend_node), 0)\n            \n            scale_blend_node = cmds.shadingNode(\"blendColors\", asUtility=True, name=\"{}_{}_ScaleBlend\".format(main_ctrl, ctrl))\n            cmds.setAttr(\"{}.blender\".format(scale_blend_node), 1)\n            cmds.setAttr(\"{}.color2R\".format(scale_blend_node), 1)\n            cmds.setAttr(\"{}.color2G\".format(scale_blend_node), 1)\n            cmds.setAttr(\"{}.color2B\".format(scale_blend_node), 1)\n            \n            #Connecting to blend nodes\n            cmds.connectAttr(\"{}.translate\".format(main_ctrl), \"{}.color1\".format(trans_blend_node))\n            cmds.connectAttr(\"{}.rotate\".format(main_ctrl), \"{}.color1\".format(rot_blend_node))\n            cmds.connectAttr(\"{}.scale\".format(main_ctrl), \"{}.color1\".format(scale_blend_node))\n            \n            #connecting to ctrl offset grp. \n            cmds.connectAttr(\"{}.output\".format(trans_blend_node), \"{}.translate\".format(new_null_group), f=True)\n            cmds.connectAttr(\"{}.output\".format(rot_blend_node), \"{}.rotate\".format(new_null_group), f=True)\n"
		+ "            cmds.connectAttr(\"{}.output\".format(scale_blend_node), \"{}.scale\".format(new_null_group), f=True)\n            \n            #Adding and connecting blend attributues on null grp. \n            translation_blend_attr = cmds.addAttr(new_null_group, ln=\"Translation_Blend\", at=\"double\", min=0, max=1, dv=1, keyable=True)\n            rotation_blend_attr = cmds.addAttr(new_null_group, ln=\"Rotation_Blend\", at=\"double\", min=0, max=1, dv=1, keyable=True)\n            scale_blend_attr = cmds.addAttr(new_null_group, ln=\"Scale_Blend\", at=\"double\", min=0, max=1, dv=1, keyable=True)\n            \n            cmds.connectAttr(\"{}.Translation_Blend\".format(new_null_group), \"{}.blender\".format(trans_blend_node))\n            cmds.connectAttr(\"{}.Rotation_Blend\".format(new_null_group), \"{}.blender\".format(rot_blend_node))\n            cmds.connectAttr(\"{}.Scale_Blend\".format(new_null_group), \"{}.blender\".format(scale_blend_node))\n            \n            #Disconnecting previously connected attrs. \n            for attr in attrs_0:\n"
		+ "                cmds.disconnectAttr(\"{}.{}\".format(main_ctrl, attr), \"{}.{}\".format(new_null_group, attr))\n            \n            for attr in attrs_1:\n                cmds.disconnectAttr(\"{}.{}\".format(main_ctrl, attr), \"{}.{}\".format(new_null_group, attr))\nctrls = [\"_Hand_Index_01_Ctrl\", \"_Hand_Middle_01_Ctrl\", \"_Hand_Ring_01_Ctrl\", \"_Hand_Pinky_01_Ctrl\"]\n         \nfor lttr in [\"L\", \"R\"]:\n    for ctrl in ctrls:\n        create_object_specific_offset(ctrl_sel=[\"{}{}\".format(lttr,ctrl)], main_ctrl=\"{}{}\".format(lttr,ctrl.replace(\"01\", \"00\")), connect=True, blend_nodes=False)       \n");
	setAttr ".postcode" -type "string" "";
createNode hyperLayout -n "hyperLayout73";
	rename -uid "E5A94D90-0B43-1438-D11C-7B8A378E6F73";
	setAttr ".ihi" 0;
	setAttr -s 2 ".hyp";
