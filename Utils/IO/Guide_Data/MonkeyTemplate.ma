	setAttr ".SetLockGuides" -type "string" "";
	setAttr ".SetLockAttrs" -type "string" "";
	setAttr ".Help" -type "string" "Will create multiple FK chains for a hair setup.\nFor SetLockCtrls set the guide from each chain you want to lock. \nFor SetLockParent set what to lock the ctrls to. \nFor SetLockAttrs set ctrl to have the lock attrs.";
	setAttr ".postcode" -type "string" (
		"from maya import cmds\n\"\"\"\nPositioned foot finger auto rotators\n\"\"\"\nfor ltr in [\"L\", \"R\"]:\n    for grp in [\"_FootIndex_A_Rotator_Ctrl_SubRoot_Grp\", \"_FootMiddle_B_Rotator_Ctrl_SubRoot_Grp\", \"_FootRing_C_Rotator_Ctrl_SubRoot_Grp\", \n                \"_FootPinky_D_Rotator_Ctrl_SubRoot_Grp\", \"_FootThumb_E_Rotator_Ctrl_SubRoot_Grp\"]:\n                    cmds.setAttr(\"{}{}.ty\".format(ltr, grp), 0.25)\n\n\"\"\"\nGroup and parent constrain controls from each side to the correct side ball joint. \n\"\"\"\n\nfor ltr in [\"L\", \"R\"]:\n    cmds.group([\"{}_FootIndex_A_01_Ctrl_Offset_Grp\".format(ltr), \"{}_FootMiddle_B_01_Ctrl_Offset_Grp\".format(ltr), \"{}_FootRing_C_01_Ctrl_Offset_Grp\".format(ltr), \n    \"{}_FootPinky_D_01_Ctrl_Offset_Grp\".format(ltr), \"{}_FootThumb_E_01_Ctrl_Offset_Grp\".format(ltr)], \n    name=\"{}_FootFingers_Ctrl_Grp\".format(ltr))\n    \n    cmds.group([\"{}_FootIndex_A_Rotator_Ctrl_SubRoot_Grp\".format(ltr), \"{}_FootMiddle_B_Rotator_Ctrl_SubRoot_Grp\".format(ltr), \"{}_FootRing_C_Rotator_Ctrl_SubRoot_Grp\".format(ltr), \n    \"{}_FootPinky_D_Rotator_Ctrl_SubRoot_Grp\".format(ltr), \"{}_FootThumb_E_Rotator_Ctrl_SubRoot_Grp\".format(ltr)], \n"
		+ "    name=\"{}_FootFingers_SubRotatorCtrls_Grp\".format(ltr))\n    \n    cmds.parentConstraint(\"{}_Foot_BallToes_Jnt\".format(ltr), \"{}_FootFingers_Ctrl_Grp\".format(ltr), mo=True)\n    cmds.parentConstraint(\"{}_Foot_BallToes_Jnt\".format(ltr), \"{}_FootFingers_SubRotatorCtrls_Grp\".format(ltr), mo=True)\n    cmds.scaleConstraint(\"{}_Foot_BallToes_Jnt\".format(ltr), \"{}_FootFingers_Ctrl_Grp\".format(ltr), mo=True)");
createNode hyperLayout -n "hyperLayout70";
	rename -uid "8C6556AC-AA47-D83C-DBE4-BF9F55F37BAF";
