createNode network -n "PushJoints_Config";
	rename -uid "7D5E6525-4467-95FF-874A-80B959EE7C86";
	addAttr -ci true -sn "precode" -ln "precode" -dt "string";
	addAttr -ci true -sn "Build_Command" -ln "Build_Command" -dt "string";
	addAttr -ci true -sn "Import_Command" -ln "Import_Command" -dt "string";
	addAttr -ci true -sn "Exec" -ln "Exec" -min 0 -max 1 -en "Python:Mel" -at "enum";
	addAttr -ci true -sn "Code" -ln "Code" -dt "string";
	addAttr -ci true -sn "postcode" -ln "postcode" -dt "string";
	setAttr ".precode" -type "string" "";
	setAttr -l on ".Build_Command" -type "string" "exec_code.build_code_block()";
	setAttr -l on ".Import_Command" -type "string" "import exec_code";
	setAttr -cb on ".Exec";
	setAttr ".Code" -type "string" (
		"import imp\nfrom imp import reload\nimport Mutant_Tools\nimport Mutant_Tools.Utils\nfrom Mutant_Tools.Utils.Rigging import main_mutant\nreload(Mutant_Tools.Utils.Rigging.main_mutant)\nmt = main_mutant.Mutant()\n\nimport maya.cmds as cmds\n\n\n#######################################################\n################### Left Side #########################\n#######################################################\n\n\n### Left Elbow Front ###\njoint_reader = mt.create_joint_reader('L_Elbow_Bnd_0_Bnd', push_joint_name='L_Push_Elbow_Fr')\nctrl, driver_joint, skl_joint = mt.create_push_joint(joint_parent=\"L_Elbow_Bnd_0_Bnd\", reader=joint_reader, push_joint_name='L_Push_Elbow_Fr_Bnd', custom_position='L_Push_Elbow_Fr_loc')\n\nmt.create_push_connections(\n    driver_attr=\"L_Push_Elbow_Fr_Reader_Loc_Quad.rotateZ\",\n    start_val=0, end_val=45,\n    driven=\"L_Push_Elbow_Fr_Ctrl_Auto_Grp\",\n    start_t=(0,0,0), end_t=(10,9,0),\n    start_r=(0,0,0), end_r=(0,0,-30),\n    start_s=(1,1,1), end_s=(1,1,1),\n    attrs_position=ctrl\n)\n\n\n### Left Elbow Back ###\n"
		+ "joint_reader = mt.create_joint_reader('L_Elbow_Bnd_0_Bnd', push_joint_name='L_Push_Elbow_Bk')\nctrl, driver_joint, skl_joint = mt.create_push_joint(joint_parent=\"L_Elbow_Bnd_0_Bnd\", reader=joint_reader, push_joint_name='L_Push_Elbow_Bk_Bnd', custom_position='L_Push_Elbow_Bk_loc')\n\nmt.create_push_connections(\n    driver_attr=\"L_Push_Elbow_Bk_Reader_Loc_Quad.rotateZ\",\n    start_val=0, end_val=90,\n    driven=\"L_Push_Elbow_Bk_Ctrl_Auto_Grp\",\n    start_t=(0,0,0), end_t=(-13,-1.5,0),\n    start_r=(0,0,0), end_r=(0,0,-45),\n    start_s=(1,1,1), end_s=(1,1,1),\n    attrs_position=ctrl\n)\n\n\n\n### Left Hip Front ###\njoint_reader = mt.create_joint_reader('L_Hip_Bnd_0_Bnd', push_joint_name='L_Push_Hip_Fr')\nctrl, driver_joint, skl_joint = mt.create_push_joint(joint_parent=\"L_Hip_Bnd_0_Bnd\", reader=joint_reader, push_joint_name='L_Push_Hip_Fr_Bnd', custom_position='L_Push_Hip_Fr_loc')\n\nmt.create_push_connections(\n    driver_attr=\"L_Push_Hip_Fr_Reader_Loc_Quad.rotateZ\",\n    start_val=0, end_val=80,\n    driven=\"L_Push_Hip_Fr_Ctrl_Auto_Grp\",\n"
		+ "    start_t=(0,0,0), end_t=(20,7,0),\n    start_r=(0,0,0), end_r=(0,0,-45),\n    start_s=(1,1,1), end_s=(1,1,1),\n    attrs_position=ctrl\n)\n\n\n### Left Hip Back ###\njoint_reader = mt.create_joint_reader('L_Hip_Bnd_0_Bnd', push_joint_name='L_Push_Hip_Bk')\nctrl, driver_joint, skl_joint = mt.create_push_joint(joint_parent=\"L_Hip_Bnd_0_Bnd\", reader=joint_reader, push_joint_name='L_Push_Hip_Bk_Bnd', custom_position='L_Push_Hip_Bk_loc')\n\nmt.create_push_connections(\n    driver_attr=\"L_Push_Hip_Bk_Reader_Loc_Quad.rotateZ\",\n    start_val=0, end_val=-60,\n    driven=\"L_Push_Hip_Bk_Ctrl_Auto_Grp\",\n    start_t=(0,0,0), end_t=(10,-5, 0),\n    start_r=(0,0,0), end_r=(0,0,20),\n    start_s=(1,1,1), end_s=(1,1,1),\n    attrs_position=ctrl\n)\n\n\n\n### Left Hip Out ###\njoint_reader = mt.create_joint_reader('L_Hip_Bnd_0_Bnd', push_joint_name='L_Push_Hip_Out')\nctrl, driver_joint, skl_joint = mt.create_push_joint(joint_parent=\"L_Hip_Bnd_0_Bnd\", reader=joint_reader, push_joint_name='L_Push_Hip_Out_Bnd', custom_position='L_Push_Hip_Out_loc')\n\n"
		+ "mt.create_push_connections(\n    driver_attr=\"L_Push_Hip_Out_Reader_Loc_Quad.rotateY\",\n    start_val=0, end_val=85,\n    driven=\"L_Push_Hip_Out_Ctrl_Auto_Grp\",\n    start_t=(0,0,0), end_t=(16,0,-10),\n    start_r=(0,0,0), end_r=(0,-40,0),\n    start_s=(1,1,1), end_s=(1,1,1),\n    attrs_position=ctrl\n)\n\n\n### Left Knee Back ###\njoint_reader = mt.create_joint_reader('L_Knee_Bnd_0_Bnd', push_joint_name='L_Push_Knee_Bk')\nctrl, driver_joint, skl_joint = mt.create_push_joint(joint_parent=\"L_Knee_Bnd_0_Bnd\", reader=joint_reader, push_joint_name='L_Push_Knee_Bk_Bnd', custom_position='L_Push_Knee_Bk_loc')\n\nmt.create_push_connections(\n    driver_attr=\"L_Push_Knee_Bk_Reader_Loc_Quad.rotateZ\",\n    start_val=0, end_val=-65,\n    driven=\"L_Push_Knee_Bk_Ctrl_Auto_Grp\",\n    start_t=(0,0,0), end_t=(15,-10,0),\n    start_r=(0,0,0), end_r=(0,0,30),\n    start_s=(1,1,1), end_s=(1,1,1),\n    attrs_position=ctrl\n)\n\n\n\n\n#######################################################\n################## Right Side #########################\n#######################################################\n"
		+ "\n\n\n### Right Elbow Front ###\njoint_reader = mt.create_joint_reader('R_Elbow_Bnd_0_Bnd', push_joint_name='R_Push_Elbow_Fr')\nctrl, driver_joint, skl_joint = mt.create_push_joint(joint_parent=\"R_Elbow_Bnd_0_Bnd\", reader=joint_reader, push_joint_name='R_Push_Elbow_Fr_Bnd', custom_position='R_Push_Elbow_Fr_loc')\n\nmt.create_push_connections(\n    driver_attr=\"R_Push_Elbow_Fr_Reader_Loc_Quad.rotateZ\",  \n    start_val=0, end_val=45, #Flip if Y\n    driven=\"R_Push_Elbow_Fr_Ctrl_Auto_Grp\",\n    start_t=(0,0,0), end_t=(-10,-9,0), #Flip X ad y\n    start_r=(0,0,0), end_r=(0,0,-30),\n    start_s=(1,1,1), end_s=(1,1,1),\n    attrs_position=ctrl\n)\n\n\n### Right Elbow Back ###\njoint_reader = mt.create_joint_reader('R_Elbow_Bnd_0_Bnd', push_joint_name='R_Push_Elbow_Bk')\nctrl, driver_joint, skl_joint = mt.create_push_joint(joint_parent=\"R_Elbow_Bnd_0_Bnd\", reader=joint_reader, push_joint_name='R_Push_Elbow_Bk_Bnd', custom_position='R_Push_Elbow_Bk_loc')\n\nmt.create_push_connections(\n    driver_attr=\"R_Push_Elbow_Bk_Reader_Loc_Quad.rotateZ\",\n"
