		+ "\nmt.create_push_connections(\n    driver_attr=\"R_Push_Hip_Bk_Reader_Loc_Quad.rotateZ\",\n    start_val=0, end_val=-60,\n    driven=\"R_Push_Hip_Bk_Ctrl_Auto_Grp\",\n    start_t=(0,0,0), end_t=(-10,5, 0), #Flip X and y\n    start_r=(0,0,0), end_r=(0,0,20),\n    start_s=(1,1,1), end_s=(1,1,1),\n    attrs_position=ctrl\n)\n\n\n\n### Right Hip Out ###\njoint_reader = mt.create_joint_reader('R_Hip_Bnd_0_Bnd', push_joint_name='R_Push_Hip_Out')\nctrl, driver_joint, skl_joint = mt.create_push_joint(joint_parent=\"R_Hip_Bnd_0_Bnd\", reader=joint_reader, push_joint_name='R_Push_Hip_Out_Bnd', custom_position='R_Push_Hip_Out_loc')\n\nmt.create_push_connections(\n    driver_attr=\"R_Push_Hip_Out_Reader_Loc_Quad.rotateY\",\n    start_val=0, end_val=-85,\n    driven=\"R_Push_Hip_Out_Ctrl_Auto_Grp\",\n    start_t=(0,0,0), end_t=(-16,0,10), #Flip X and z\n    start_r=(0,0,0), end_r=(0,-40,0), \n    start_s=(1,1,1), end_s=(1,1,1),\n    attrs_position=ctrl\n)\n\n\n### Right Knee Back ###\njoint_reader = mt.create_joint_reader('R_Knee_Bnd_0_Bnd', push_joint_name='R_Push_Knee_Bk')\n"
		+ "ctrl, driver_joint, skl_joint = mt.create_push_joint(joint_parent=\"R_Knee_Bnd_0_Bnd\", reader=joint_reader, push_joint_name='R_Push_Knee_Bk_Bnd', custom_position='R_Push_Knee_Bk_loc')\n\nmt.create_push_connections(\n    driver_attr=\"R_Push_Knee_Bk_Reader_Loc_Quad.rotateZ\",\n    start_val=0, end_val=-65,\n    driven=\"R_Push_Knee_Bk_Ctrl_Auto_Grp\",\n    start_t=(0,0,0), end_t=(-15,10,0),\n    start_r=(0,0,0), end_r=(0,0,30),\n    start_s=(1,1,1), end_s=(1,1,1),\n    attrs_position=ctrl\n)\n\n\n\"\"\"\nOrganizing created setups\n\"\"\"\nprint(cmds.ls(sl=True))\n\n# Grouping Push Joint Setup Groups\ncmds.group(['L_Push_Elbow_FrPushReaders_Grp', 'L_Push_Elbow_BkPushReaders_Grp', 'L_Push_Hip_FrPushReaders_Grp', 'L_Push_Hip_BkPushReaders_Grp', 'L_Push_Hip_OutPushReaders_Grp', 'L_Push_Knee_BkPushReaders_Grp'],\n            name=\"L_PushJointReaderSetupGroups_Grp\")\n\ncmds.group(['R_Push_Elbow_FrPushReaders_Grp', 'R_Push_Elbow_BkPushReaders_Grp', 'R_Push_Hip_FrPushReaders_Grp', 'R_Push_Hip_BkPushReaders_Grp', 'R_Push_Hip_OutPushReaders_Grp', 'R_Push_Knee_BkPushReaders_Grp'],\n"
		+ "            name=\"R_PushJointReaderSetupGroups_Grp\")\n            \ncmds.group(['L_PushJointReaderSetupGroups_Grp', 'R_PushJointReaderSetupGroups_Grp'], name=\"PushJoints_Setup_Grp\")\ncmds.parent(\"PushJoints_Setup_Grp\", \"Miscellaneous_Grp\")\n\n\n\n# Grouping Push Joint Control Groups\ncmds.group(['L_Push_Elbow_Fr_Ctrl_Root_Grp', 'L_Push_Hip_Fr_Ctrl_Root_Grp', 'L_Push_Hip_Bk_Ctrl_Root_Grp', 'L_Push_Hip_Out_Ctrl_Root_Grp', 'L_Push_Knee_Bk_Ctrl_Root_Grp', 'L_Push_Elbow_Bk_Ctrl_Root_Grp'],\n            name=\"L_PushJointControlsGroups_Grp\")\n\ncmds.group(['R_Push_Elbow_Fr_Ctrl_Root_Grp', 'R_Push_Hip_Fr_Ctrl_Root_Grp', 'R_Push_Hip_Bk_Ctrl_Root_Grp', 'R_Push_Hip_Out_Ctrl_Root_Grp', 'R_Push_Knee_Bk_Ctrl_Root_Grp', 'R_Push_Elbow_Bk_Ctrl_Root_Grp'],\n            name=\"R_PushJointControlsGroups_Grp\")\n            \ncmds.group(['L_PushJointControlsGroups_Grp', 'R_PushJointControlsGroups_Grp'], name=\"PushJoints_Controls_Grp\")\ncmds.parent(\"PushJoints_Controls_Grp\", \"Ctrl_Grp\")\n");
